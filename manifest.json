{
  "manifest_version": 3,
  "name": "CodeTrail - Sync LeetCode to GitHub",
  "version": "2.0.0",
  "description": "Automatically sync your LeetCode solutions to GitHub with topic-based organization",
  "permissions": ["storage", "notifications", "webNavigation", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://leetcode.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "codetrail@thivakar.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": [
        "content/constants.js",
        "content/modal.js",
        "content/scraper.js",
        "content/graphql.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["utils/constants.js", "icons/*.png"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
